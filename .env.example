# GEMINI_API_KEY: Required for Gemini AI explanation generation on the backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PAYPAL SANDBOX CREDENTIALS (Server-side only - never expose secrets to frontend)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# SQLite database path (defaults to ./data/paypal_shield.db)
DATABASE_PATH="./data/paypal_shield.db"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
